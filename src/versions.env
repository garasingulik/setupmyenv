# setupmyenv — pinned versions (single source of truth)
#
# Edit here, then run ./build.sh to regenerate the root scripts.
# CI fails if the committed scripts are out of sync with this file.
# Last re-baselined: 2026-09-03

# ---------------------------------------------------------------------------
# asdf-managed language / tool runtimes
# ---------------------------------------------------------------------------
NODEJS_VERSION=24.20.0
PYTHON_VERSION=3.13.15
GOLANG_VERSION=1.27.1
JAVA_VERSION=temurin-25.0.4+7
FLUTTER_VERSION=3.47.2-stable
TERRAFORM_VERSION=1.16.1
KUBECTL_VERSION=1.37.0
HELM_VERSION=4.2.4
SOPS_VERSION=3.13.3
RUBY_VERSION=3.4.10

# ---------------------------------------------------------------------------
# Bootstrap tooling
# ---------------------------------------------------------------------------
# asdf itself. On Linux it is installed from the GitHub release binary
# (Homebrew is no longer used on Linux); on macOS it comes from Homebrew.
ASDF_VERSION=0.20.0

# ---------------------------------------------------------------------------
# Android SDK
# ---------------------------------------------------------------------------
ANDROID_CMDLINE_TOOLS_BUILD=14742923
ANDROID_PLATFORM=android-36
ANDROID_BUILD_TOOLS=36.0.0

# ---------------------------------------------------------------------------
# OpenSSL 1.1 backward-compat shim (Ubuntu <= 22.04 only; see SPEC.md B10)
# ---------------------------------------------------------------------------
LIBSSL1_DEB=libssl1.1_1.1.1n-0+deb10u6_amd64.deb
LIBSSL1_DEB_BASEURL=http://security.debian.org/debian-security/pool/updates/main/o/openssl

# ---------------------------------------------------------------------------
# Optional SHA-256 checksums for directly-downloaded artifacts.
# Leave blank to skip verification (a warning is printed). Populate to enforce.
# These rotate on every version bump above — update them together.
# ---------------------------------------------------------------------------
ANDROID_CMDLINE_TOOLS_SHA256=
LIBSSL1_DEB_SHA256=
